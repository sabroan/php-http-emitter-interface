{
    "name": "sabroan/http-emitter-interface",
    "description": "A PHP interface for emitting PSR-7 HTTP responses",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=8",
        "psr/http-message": "^2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54"
    },
    "autoload": {
        "psr-4": {
            "Sabroan\\Http\\Emitter\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
